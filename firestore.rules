rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Safety Net & Helpers
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Role verification against trusted database document or bootstrapped admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null &&
         request.auth.token.email.lower() == 'tajmilur.kopol@gmail.com' &&
         request.auth.token.email_verified == true)
      );
    }

    // ===============================================================
    // Validation Blueprints
    // ===============================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'marketPrice']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 120 &&
        data.category is string && data.category.size() <= 60 &&
        data.marketPrice is number && data.marketPrice >= 0 &&
        (!('brand' in data) || (data.brand is string && data.brand.size() <= 80)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerEmail', 'customerPhone', 'total', 'status']) &&
        data.id is string && data.id.size() <= 64 &&
        data.customerName is string && data.customerName.size() <= 120 &&
        data.customerEmail is string && data.customerEmail.size() <= 256 &&
        data.customerPhone is string && data.customerPhone.size() <= 30 &&
        data.total is number && data.total >= 0 &&
        data.status is string && data.status.size() <= 30;
    }

    function isValidConsultation(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'industryId']) &&
        data.id is string && data.id.size() <= 64 &&
        data.name is string && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.industryId is string && data.industryId.size() <= 60;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['siteTitle', 'supportPhone']) &&
        data.siteTitle is string && data.siteTitle.size() <= 200 &&
        data.supportPhone is string && data.supportPhone.size() <= 30;
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // Connectivity Test
    match /test/{docId} {
      allow read: if true;
    }

    // Admins Collection
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Users Collection (Strict PII isolation: get limited to owner or admin)
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && isValidUserProfile(incoming()) && incoming().uid == request.auth.uid;
      allow update: if (isOwner(uid) || isAdmin()) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isAdmin();
    }

    // Products Catalogue (Public read, admin write)
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Customer Orders (Create permitted, read scoped to user/admin)
    match /orders/{orderId} {
      allow create: if isValidOrder(incoming());
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Consultations (Inbound discovery leads)
    match /consultations/{consultationId} {
      allow create: if isValidConsultation(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // Site Settings (Public read, admin write)
    match /site_settings/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidSiteSettings(incoming());
    }
  }
}
